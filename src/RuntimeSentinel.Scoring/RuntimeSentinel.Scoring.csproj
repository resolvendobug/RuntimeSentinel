<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>RuntimeSentinel.Scoring</PackageId>
    <Version>0.1.3</Version>
    <Authors>RuntimeSentinel contributors</Authors>
    <Description>Operational risk scoring primitives for C# code, including weighted risk dimensions and report generation in JSON and Markdown.</Description>
    <PackageTags>dotnet;roslyn;scoring;risk;analysis;concurrency;async;memory</PackageTags>
    <RepositoryUrl>https://github.com/resolvendobug/RuntimeSentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RuntimeSentinel.Analyzers\RuntimeSentinel.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
